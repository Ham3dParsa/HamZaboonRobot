0 */6 * * * root /usr/local/bin/update_xray_subscription.sh >> /var/log/xray_update.log 2>&1
# Keepalive: exact-name match (a -f pattern would self-match this cmdline).
# If supervisord answers, it owns xray (kick start, trust autorestart) and no
# raw launch happens — this avoids a duplicate fighting for the port. Raw
# launch only when the daemon itself is unreachable, gated by binary +
# non-empty config + JSON validity (`xray test` does not exist on the pinned
# build, so python validates structure instead). Paths fixed to /app/hamzaban
# (same as supervisor.conf and scripts/xray/*); non-default BASE_ROOT unsupported.
* * * * * root pgrep -x xray > /dev/null || { if supervisorctl -c /app/hamzaban/supervisor.conf status >/dev/null 2>&1; then supervisorctl -c /app/hamzaban/supervisor.conf start xray >/dev/null 2>&1 || true; else test -x /usr/local/bin/xray && test -s /app/hamzaban/.xray/config.json && python3 -c "import json,sys; sys.exit(0 if json.load(open('/app/hamzaban/.xray/config.json')).get('outbounds') else 1)" >/dev/null 2>&1 && /usr/local/bin/xray run -c /app/hamzaban/.xray/config.json >> /var/log/xray/xray.log 2>&1 & fi; }
