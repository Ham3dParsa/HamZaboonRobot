# HamZaboon Configuration File (.env.example)
# -------------------------------------------
# 1. Copy this file to '.env' before starting the bot.
# 2. NEVER commit a file containing actual secrets.
#
# Lexicon-factory research keys (phases 2/3) live in factory/.env —
# see factory/.env.example. Never reuse the bot runtime key below for factory runs.

# --- TELEGRAM & BOT AUTH ---
# Required for Telegram bot identification and owner authorization.
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=123456789

# --- AI PROVIDER (LLM) ---
# API configuration for the LLM provider. Defaults can be overridden in the admin panel.
AI_BASE_URL=https://api.gapgpt.app/v1
AI_API_KEY=sk-replace-this-with-a-real-key
AI_MODEL=gemini-flash-lite-latest

# --- AI PRESET API KEYS (Master Key + Key Storage) ---
# AI_MASTER_KEY is REQUIRED. It is the Fernet master key used to encrypt API
# keys at rest in the database. Every stored API key (preset, group, and the
# legacy ai_api_key setting) is encrypted before it is written, and decrypted
# at runtime only when resolving a key for a provider call. Fail-closed:
# if AI_MASTER_KEY is missing or invalid, encryption produces nothing and
# resolution returns an empty key, so presets will fail to connect until it is
# set correctly. The migration skips (does not destroy) existing values when
# the master key is absent, so it can be added later and startup will encrypt.
#
# Generate a fresh key once (do NOT reuse the example below in production):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and back it up; losing it makes stored keys undecryptable.
AI_MASTER_KEY=

# Optional proxy for AI provider geoblock bypass (e.g. Hetzner DE).
# When set, all OpenAI-compatible AI calls are routed via this proxy
# (e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:8080). Telegram
# traffic stays direct. Leave empty to disable.
AI_PROXY_URL=
# When true, a bad AI_PROXY_URL fails fast instead of silently falling back
# to direct (which would re-expose geoblock). Default false keeps fallback.
AI_PROXY_STRICT=false

# TTS cache channel (optional): chat_id for archiving TTS voices (e.g. -100...).
# Can also be set via admin panel tts_cache_chat_id. If stored setting is
# explicitly set to "" (cleared via admin), caching is intentionally disabled
# and env TTS_CACHE_CHAT_ID is NOT used as fallback — set a non-empty value
# to re-enable. Channel fallback order: settings row wins over env.
TTS_CACHE_CHAT_ID=
TTS_CACHE_DB_PATH=tts_cache.db

# --- DATABASE & LOCALIZATION ---
# SQLite file path.
DB_PATH=hamzaban.db

# IANA timezone (e.g., 'Asia/Tehran') and time formats (HH:MM).
APP_TIMEZONE=Asia/Tehran
ACTIVE_WINDOW_START=08:00
ACTIVE_WINDOW_END=21:00
PREFERRED_DELIVERY_TIME=09:00
SRS_REMINDER_TIME=10:00

# --- USAGE LIMITS (BY PLAN) ---
# Plan limits (daily sessions, cards per session, word-query quota) are
# stored in the `plans` database table and seeded on first run. They are
# managed at runtime by the admin plan-manager wizard; there are no plan
# limit environment variables.

# Enable only for local development/testing.
OWNER_BYPASS_LIMITS=false

# --- SCHEDULING, CONCURRENCY & SAFETY ---
# Learner-facing session policy.
MIN_SESSIONS=3
MAX_SESSIONS=6
TARGET_CARDS_PER_SESSION=3

# Scheduler settings.
SCHEDULER_SLOT_MINUTES=30
SCHEDULER_BUCKET_CAPACITY=4

# Provider and API safety limits.
AI_MAX_CONCURRENCY=2
AI_MAX_REQUESTS_PER_MINUTE=30
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.6
AI_MAX_OUTPUT_TOKENS=4096

# Card output format: 'compact_json' (recommended), 'json' (rollback).
AI_CARD_OUTPUT_FORMAT=compact_json

# Default card presentation ('brief' or 'detailed').
DEFAULT_PRESENTATION=detailed

# Cost analytics defaults (USD and Toman conversion).
LLM_INPUT_COST_USD_PER_MILLION=0.25
LLM_OUTPUT_COST_USD_PER_MILLION=1.5
USD_TO_TOMAN_RATE=190000

# Telegram API concurrency and message delivery settings.
TELEGRAM_MAX_CONCURRENCY=6
# Max concurrent users targeted by one admin broadcast fan-out (bounded by
# TELEGRAM_MAX_CONCURRENCY at the transport level).
BROADCAST_MAX_CONCURRENCY=20
SESSION_CARD_DELAY_SECONDS=0.3
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_SECONDS=60

# --- LOGGING ---
# Minimum log level for console output (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Can be overridden at runtime via the admin panel "📋 سطح لاگ" button.
LOG_LEVEL=INFO

# Enable user-activity tracking at the 👤 USER log level (on/off).
# Can be toggled at runtime via the admin panel "👤 لاگ فعالیت کاربر" button.
USER_ACTIVITY_LOG=off

# --- PHONETIC DISPLAY ---
# Phonetic transcription is now a per-user display toggle (config/catalog.py
# DISPLAY_TOGGLE_FIELDS); the admin-global default is edited via the admin panel
# "phonetics" section. No environment knob.
