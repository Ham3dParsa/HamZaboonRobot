# ===== تلگرام =====
# توکن ربات را از @BotFather بگیر
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی خودت (مالک ربات). از @userinfobot بگیر.
# فقط همین آیدی دکمه‌ی "🛠 مدیریت ربات" رو تو کیبورد می‌بینه.
OWNER_ID=123456789

# ===== هوش مصنوعی (سازگار با OpenAI SDK) =====
# این سه مقدار فقط "پیش‌فرض اولیه"‌اند؛ بعد از اجرای اول ربات، مالک می‌تواند
# از داخل پنل مدیریت ربات (توی خود تلگرام) این‌ها را بدون ری‌استارت کردن سرور عوض کند.
AI_BASE_URL=https://api.gapgpt.app/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gemini-flash-lite-latest

# ===== دیتابیس و رفتار ربات =====
DB_PATH=DATA.db
# ساعت ارسال خودکار کارت روزانه (بر اساس تایم‌زون سروری که ربات رویش اجرا می‌شود)
DAILY_SEND_HOUR=9
# بازه و ظرفیت زمان‌بندی تحویل (دقیقه از نیمه‌شب)
ACTIVE_START_MINUTE=480
ACTIVE_END_MINUTE=1260
PREFERRED_DELIVERY_MINUTE=540
SCHEDULER_SLOT_MINUTES=30
SCHEDULER_BUCKET_CAPACITY=4
MIN_SESSIONS=3
MAX_SESSIONS=6
TARGET_CARDS_PER_SESSION=3
# محدودکننده‌های سراسری برای API و تلگرام
AI_MAX_CONCURRENCY=2
AI_MAX_REQUESTS_PER_MINUTE=30
TELEGRAM_MAX_CONCURRENCY=4
SESSION_CARD_DELAY_SECONDS=0.3
# سقف روزانه‌ی «پرسیدن واژه‌ی دلخواه» برای پلن رایگان
FREE_DAILY_WORD_LIMIT=4
# مالک ربات از محدودیت‌های پلن عبور کند
OWNER_BYPASS_LIMITS=true
