# HamZaboon deployment defaults
# Copy to .env and replace placeholders. Never commit a real secret.

# ===== Required Telegram settings =====
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=123456789

# ===== AI bootstrap settings =====
# These are initial values only. The owner can override them from the
# admin panel at runtime; the API key below is intentionally fake.
AI_BASE_URL=https://api.gapgpt.app/v1
AI_API_KEY=sk-replace-this-with-a-real-key
AI_MODEL=gemini-flash-lite-latest

# ===== Beginner settings =====
# SQLite database file. Keep it on persistent storage in production.
DB_PATH=hamzaban.db

# All clock values use this IANA timezone and the HH:MM format.
APP_TIMEZONE=Asia/Tehran
ACTIVE_WINDOW_START=08:00
ACTIVE_WINDOW_END=21:00
PREFERRED_DELIVERY_TIME=09:00
SRS_REMINDER_TIME=10:00

# Daily card allowances by subscription plan.
FREE_DAILY_CARD_LIMIT=3
SILVER_DAILY_CARD_LIMIT=12
GOLD_DAILY_CARD_LIMIT=30

# Daily custom-word query allowances by subscription plan.
# Use -1 for unlimited.
FREE_DAILY_WORD_QUERY_LIMIT=3
SILVER_DAILY_WORD_QUERY_LIMIT=16
GOLD_DAILY_WORD_QUERY_LIMIT=40

# Keep false in production. Enable only for local development/testing.
OWNER_BYPASS_LIMITS=false

# ===== Advanced scheduling and safety settings =====
# Learner-facing session policy. These are independent of plan names.
MIN_SESSIONS=3
MAX_SESSIONS=6
TARGET_CARDS_PER_SESSION=3

# Scheduler resolution and maximum sessions per time bucket.
SCHEDULER_SLOT_MINUTES=30
SCHEDULER_BUCKET_CAPACITY=4

# Global provider and Telegram safety limits.
AI_MAX_CONCURRENCY=2
AI_MAX_REQUESTS_PER_MINUTE=30
AI_TIMEOUT_SECONDS=30
TELEGRAM_MAX_CONCURRENCY=4
SESSION_CARD_DELAY_SECONDS=0.3

# Failed scheduled sessions retry with exponential backoff until this limit.
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_SECONDS=60
