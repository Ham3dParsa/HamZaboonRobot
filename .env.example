# HamZaboon Configuration File (.env.example)
# -------------------------------------------
# 1. Copy this file to '.env' before starting the bot.
# 2. NEVER commit a file containing actual secrets.

# --- TELEGRAM & BOT AUTH ---
# Required for Telegram bot identification and owner authorization.
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=123456789

# --- AI PROVIDER (LLM) ---
# API configuration for the LLM provider. Defaults can be overridden in the admin panel.
AI_BASE_URL=https://api.gapgpt.app/v1
AI_API_KEY=sk-replace-this-with-a-real-key
AI_MODEL=gemini-flash-lite-latest

# --- AI PRESET API KEYS (Environment Variable References) ---
# For security, actual API keys are NOT stored in the database. Instead,
# the database stores environment variable names (e.g., "$HpOF_API_KEY").
# Before starting the bot or the AI Preset Manager tool, set these variables.
#
# How it works:
#   1. Database stores "$ENV_VAR_NAME" as the api_key value
#   2. At runtime, resolve_api_key() reads the actual key from the environment
#   3. If the env var is not set, the preset will fail to connect
#
# To use a literal key instead of an env var reference, simply put the key
# directly in the database (not recommended — prefer environment variables).
#
# Required per provider:
HpOF_API_KEY=sk-replace-with-your-hpof-api-key
ELI_API_KEY=sk-replace-with-your-eliapi-api-key
GAPGPT_API_KEY=sk-replace-with-your-gapgpt-api-key

# --- DATABASE & LOCALIZATION ---
# SQLite file path.
DB_PATH=hamzaban.db

# IANA timezone (e.g., 'Asia/Tehran') and time formats (HH:MM).
APP_TIMEZONE=Asia/Tehran
ACTIVE_WINDOW_START=08:00
ACTIVE_WINDOW_END=21:00
PREFERRED_DELIVERY_TIME=09:00
SRS_REMINDER_TIME=10:00

# --- USAGE LIMITS (BY PLAN) ---
# Plan limits (daily sessions, cards per session, word-query quota) are
# stored in the `plans` database table and seeded on first run. They are
# managed at runtime by the admin plan-manager wizard; there are no plan
# limit environment variables.

# Enable only for local development/testing.
OWNER_BYPASS_LIMITS=false

# --- SCHEDULING, CONCURRENCY & SAFETY ---
# Learner-facing session policy.
MIN_SESSIONS=3
MAX_SESSIONS=6
TARGET_CARDS_PER_SESSION=3

# Scheduler settings.
SCHEDULER_SLOT_MINUTES=30
SCHEDULER_BUCKET_CAPACITY=4

# Provider and API safety limits.
AI_MAX_CONCURRENCY=2
AI_MAX_REQUESTS_PER_MINUTE=30
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.6
AI_MAX_OUTPUT_TOKENS=4096

# Card output format: 'compact_json' (recommended), 'json' (rollback).
AI_CARD_OUTPUT_FORMAT=compact_json

# Default card presentation ('brief' or 'detailed').
DEFAULT_PRESENTATION=detailed

# Cost analytics defaults (USD and Toman conversion).
LLM_INPUT_COST_USD_PER_MILLION=0.25
LLM_OUTPUT_COST_USD_PER_MILLION=1.5
USD_TO_TOMAN_RATE=190000

# Telegram API concurrency and message delivery settings.
TELEGRAM_MAX_CONCURRENCY=6
SESSION_CARD_DELAY_SECONDS=0.3
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_SECONDS=60

# --- LOGGING ---
# Minimum log level for console output (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Can be overridden at runtime via the admin panel "📋 سطح لاگ" button.
LOG_LEVEL=INFO

# Enable user-activity tracking at the 👤 USER log level (on/off).
# Can be toggled at runtime via the admin panel "👤 لاگ فعالیت کاربر" button.
USER_ACTIVITY_LOG=off

# --- PHONETIC DISPLAY ---
# Toggle IPA phonetic transcription in card rendering.
PHONETIC_SHOW_IPA=true
